{
  // Without this file `npm run typecheck` found no inputs, printed tsc's help
  // and exited 0 — a green check that checked nothing. The SDK types under
  // types/ are generated by bb's plugin tooling and gitignored, so the paths
  // below point at them rather than at a published package.
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "types": ["node", "react"],
    "paths": {
      "@bb/plugin-sdk": ["./types/bb-plugin-sdk.d.ts"],
      "@bb/plugin-sdk/app": ["./types/bb-plugin-sdk-app.d.ts"]
    }
  },
  "include": ["app.tsx", "server.ts", "lib/**/*.ts"]
}
